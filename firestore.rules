// تحذير: لا تنشر هذه القواعد قبل اكتمال ربط الحسابات بمصادقة Firebase.
// القواعد تفترض وجود user_accounts/{accountId}، حيث accountId يأتي من custom claim
// أو يساوي request.auth.uid في المشاريع التي تستخدم UID كمعرف الحساب.
// النشر لاحقاً عبر: firebase deploy --only firestore:rules,storage
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function accountId() {
      return isSignedIn() && request.auth.token.accountId != null
        ? request.auth.token.accountId
        : request.auth.uid;
    }

    function hasAccountDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_accounts/$(accountId()));
    }

    function accountDoc() {
      return get(/databases/$(database)/documents/user_accounts/$(accountId())).data;
    }

    function myRole() {
      return hasAccountDoc() ? accountDoc().role : 'none';
    }

    function isActive() {
      return hasAccountDoc() && accountDoc().accountStatus == 'active';
    }

    function isAdmin() {
      return isActive() && myRole() == 'admin';
    }

    function isTreasurer() {
      return isActive() && (myRole() == 'admin' || myRole() == 'treasurer');
    }

    function isAuditor() {
      return isActive() && (myRole() == 'admin' || myRole() == 'treasurer' || myRole() == 'auditor');
    }

    function isStaff() {
      return isActive() && (myRole() in ['admin', 'treasurer', 'dataEntry', 'auditor']);
    }

    function isMember() {
      return isActive() && myRole() == 'member';
    }

    function currentUserEmployeeId() {
      return isActive() && accountDoc().employeeId is string ? accountDoc().employeeId : '';
    }

    function currentUserEmployeeCode() {
      return isActive() && accountDoc().employeeCode is string ? accountDoc().employeeCode : '';
    }

    function ownsEmployeeRecord(employeeDocId) {
      return isMember()
        && (
          employeeDocId == currentUserEmployeeId()
          || (currentUserEmployeeCode() != '' && resource.data.jobId == currentUserEmployeeCode())
          || (currentUserEmployeeCode() != '' && resource.data.employeeCode == currentUserEmployeeCode())
        );
    }

    function ownsMemberRecord() {
      return isMember()
        && (
          resource.data.memberId == currentUserEmployeeId()
          || (currentUserEmployeeCode() != '' && resource.data.memberId == currentUserEmployeeCode())
        );
    }

    match /user_accounts/{uid} {
      allow read: if isAdmin() || (isSignedIn() && accountId() == uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && accountId() == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'accountStatus',
          'permissionOverrides',
          'employeeId',
          'employeeCode',
          'jobId',
          'nationalId',
          'phone',
          'email',
          'firebaseUid'
        ]));
      allow delete: if isAdmin();
    }

    match /auth_sessions/{sid} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == accountId());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == accountId());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == accountId());
    }

    match /audit_logs/{id} {
      allow read: if isAuditor();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /employees/{id} {
      allow read: if isStaff() || ownsEmployeeRecord(id);
      allow create, update: if isAdmin() || myRole() == 'dataEntry' || isTreasurer();
      allow delete: if isAdmin();
    }

    match /member_movements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin() || isTreasurer();
    }

    match /member_benefits/{id} {
      allow read: if isStaff() || ownsMemberRecord();
      allow create, update: if isStaff();
      allow delete: if isAdmin() || isTreasurer();
    }

    match /transactions/{id} {
      allow read: if isAuditor() || isTreasurer();
      allow create: if isTreasurer() || myRole() == 'dataEntry';
      allow update: if isTreasurer();
      allow delete: if isAdmin();
    }

    match /issued_checks/{id} {
      allow read: if isAuditor() || isTreasurer();
      allow create: if isTreasurer() || myRole() == 'dataEntry';
      allow update: if isTreasurer();
      allow delete: if isAdmin();
    }

    match /checkbooks/{id} {
      allow read: if isAuditor() || isTreasurer();
      allow create: if isTreasurer() || myRole() == 'dataEntry';
      allow update: if isTreasurer();
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if isStaff() || isMember();
      allow create, update: if isAdmin() || isTreasurer();
      allow delete: if isAdmin();
    }

    match /event_bookings/{id} {
      allow read: if isStaff() || ownsMemberRecord();
      allow create, update: if isStaff();
      allow delete: if isAdmin() || isTreasurer();
    }

    match /board_terms/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /board_memberships/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /board_candidates/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /board_movements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /board_benefits/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isTreasurer();
      allow delete: if isAdmin();
    }

    match /board_meetings/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /settings/dropdowns/{id} {
      allow read: if isStaff();
      allow write: if isAdmin() || isTreasurer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
